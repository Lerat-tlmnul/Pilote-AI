# GEMINI_API_KEY: Optional if using Gemini models
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted
APP_URL="https://my-app.vercel.app"

# NVIDIA NIM API Configuration for Pilote 1
# Recommended active models on integrate.api.nvidia.com:
# - meta/llama-3.2-11b-vision-instruct (Default, highly available and fast)
# - z-ai/glm-5.3-flash
# - openai/gpt-oss-20b
# - deepseek-ai/deepseek-v4.1-flash
NVIDIA_API_KEY="nvapi-your-key-here"
NVIDIA_MODEL_NAME="meta/llama-3.2-11b-vision-instruct"

# Google Maps Platform API Key
VITE_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
